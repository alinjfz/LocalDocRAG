# ─────────────────────────────────────────────────────────────────────────────
# DocMind — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# Single-user credentials for the web app
APP_USERNAME=admin

# Generate a bcrypt hash of your password (no Python needed — uses Docker):
#   docker run --rm python:3.11-slim python3 -c \
#     "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
# Or if you have Python 3 locally:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
APP_PASSWORD_HASH=$2b$12$CHANGE_THIS_TO_A_REAL_BCRYPT_HASH_OF_YOUR_PASSWORD

# Random secret for signing JWT tokens (min 32 chars)
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG

# Token expiry in minutes (default: 8 hours = 480)
JWT_EXPIRE_MINUTES=480

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: openai | anthropic | ollama
# Use 'ollama' for fully local inference on Raspberry Pi (no API key needed)
LLM_PROVIDER=ollama

# ── OpenAI (if LLM_PROVIDER=openai, or for RAGAS evaluation) ─────────────────
OPENAI_API_KEY=

# ── Anthropic (if LLM_PROVIDER=anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Ollama (if LLM_PROVIDER=ollama) ──────────────────────────────────────────
# Points to the ollama service in docker-compose
OLLAMA_BASE_URL=http://ollama:11434

# Model recommendations by hardware:
#   Pi 4  4GB: phi3:mini            (2.3GB)
#   Pi 4  8GB: llama3.2:3b          (2.0GB)
#   Pi 5  8GB: llama3.1:8b          (4.7GB)
#   Pi 5 16GB: qwen2.5:14b          (8.2GB) ← recommended for Pi 5 16GB
#   Pi 5 16GB: deepseek-r1:14b      (8.5GB) ← best for reasoning/analysis
#   Pi 5 16GB: gemma2:27b:q4_K_M    (15GB)  ← maximum quality
OLLAMA_LLM_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── OpenAI model names (if LLM_PROVIDER=openai) ───────────────────────────────
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Anthropic model name (if LLM_PROVIDER=anthropic) ─────────────────────────
ANTHROPIC_LLM_MODEL=claude-haiku-4-5-20251001

# ── Database ──────────────────────────────────────────────────────────────────
# Overridden at runtime by docker-compose.yml using DB_PASSWORD
DATABASE_URL=postgresql+psycopg://docmind_user:docmind_secret_change_me@db:5432/docmind

# Change this password! Used by docker-compose for the PostgreSQL service.
DB_PASSWORD=docmind_secret_change_me

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
MAX_FILE_SIZE_MB=20

# Must match your embedding model's output dimension:
#   OpenAI text-embedding-3-small: 1536
#   Ollama nomic-embed-text:        768
EMBEDDING_DIMENSION=768

# ── RAGAS Evaluation ─────────────────────────────────────────────────────────
# RAGAS uses OpenAI as judge even in Ollama mode. Requires OPENAI_API_KEY.
RAGAS_LLM_MODEL=gpt-4o-mini

# ── CORS allowed origins (comma-separated) ────────────────────────────────────
# Add your Pi's local IP so home network devices can connect.
# Example: ALLOWED_ORIGINS=https://localhost,https://docmind.local,https://192.168.1.100
ALLOWED_ORIGINS=https://localhost,https://docmind.local,http://localhost:5173
