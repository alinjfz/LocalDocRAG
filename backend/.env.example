# Backend .env.example — see root .env.example for full documentation
# This file is mounted by docker-compose via env_file: .env (root level)
# For local development without Docker, copy root .env.example to backend/.env

APP_USERNAME=admin
APP_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

DATABASE_URL=postgresql+psycopg://docmind_user:docmind_secret@localhost:5432/docmind

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
MAX_FILE_SIZE_MB=20
EMBEDDING_DIMENSION=768

RAGAS_LLM_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=https://localhost,https://docmind.local,http://localhost:5173
